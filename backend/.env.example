MAIL_USER=tu-correo@gmail.com
MAIL_PASS=tu-contraseña-de-aplicacion
# Opcional: si usas Resend para correos transaccionales en producción:
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=Barber Hub <no-reply@correo.barber-hub.com.mx>
MODERATOR_EMAIL=tu-correo@ejemplo.com

# Supabase (config > project settings > API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Mercado Pago (developers.mercadopago.com > tu app > credenciales)
MP_ACCESS_TOKEN=tu-access-token
MP_WEBHOOK_SECRET=tu-clave-secreta-de-webhook

# URLs para redirecciones y notificaciones (en producción, usa tus dominios reales)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
PORT=3000
